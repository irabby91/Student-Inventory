<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#FFFFFF"
    tools:context=".viewModel.MainActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!--==========================
               PURPLE HEADER
        ===========================-->

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/headerLayout"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/bg_header"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintDimensionRatio="H,1:0.8">

            <!-- Decorative Top Right Circles -->

            <View
                android:id="@+id/circleOuter"
                android:layout_width="180dp"
                android:layout_height="180dp"
                android:background="@drawable/bg_circle_big"
                android:alpha=".08"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="-40dp"
                android:layout_marginEnd="-40dp"/>

            <View
                android:id="@+id/circleMiddle"
                android:layout_width="130dp"
                android:layout_height="130dp"
                android:background="@drawable/bg_circle_big"
                android:alpha=".10"
                app:layout_constraintTop_toTopOf="@id/circleOuter"
                app:layout_constraintBottom_toBottomOf="@id/circleOuter"
                app:layout_constraintStart_toStartOf="@id/circleOuter"
                app:layout_constraintEnd_toEndOf="@id/circleOuter"/>

            <View
                android:id="@+id/circleInner"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:background="@drawable/bg_circle_big"
                android:alpha=".12"
                app:layout_constraintTop_toTopOf="@id/circleOuter"
                app:layout_constraintBottom_toBottomOf="@id/circleOuter"
                app:layout_constraintStart_toStartOf="@id/circleOuter"
                app:layout_constraintEnd_toEndOf="@id/circleOuter"/>

            <!-- Bottom Left Circle -->

            <View
                android:layout_width="220dp"
                android:layout_height="220dp"
                android:background="@drawable/bg_circle_big"
                android:alpha=".05"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginBottom="-80dp"
                android:layout_marginStart="-80dp"/>

            <!-- Icon Container -->

            <androidx.cardview.widget.CardView
                android:id="@+id/iconContainer"
                android:layout_width="72dp"
                android:layout_height="72dp"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#22FFFFFF"
                app:layout_constraintVertical_chainStyle="packed"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@id/txtTitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center"
                    android:src="@drawable/graduate"
                    app:tint="@android:color/white"/>

            </androidx.cardview.widget.CardView>

            <!-- Title -->

            <TextView
                android:id="@+id/txtTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Student\nEnrollment"
                android:textAlignment="center"
                android:textColor="@android:color/white"
                android:textSize="28sp"
                android:fontFamily="@font/dm_seriff_display"
                android:lineSpacingExtra="0dp"
                android:layout_marginTop="20dp"
                app:layout_constraintTop_toBottomOf="@id/iconContainer"
                app:layout_constraintBottom_toTopOf="@id/txtSubtitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <TextView
                android:id="@+id/txtSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ACADEMIC COURSE MANAGER"
                android:textColor="#C5C4FF"
                android:textSize="11sp"
                android:fontFamily="@font/plus_jakarta_sans"
                android:letterSpacing=".18"
                android:layout_marginTop="12dp"
                app:layout_constraintTop_toBottomOf="@id/txtTitle"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!--==========================
                WHITE SECTION
        ===========================-->

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/bottomLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="#F8F9FF"
            android:padding="32dp"
            app:layout_constraintTop_toBottomOf="@id/headerLayout"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/txtManageHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Manage your courses with ease"
                android:textColor="#1A1C3D"
                android:textSize="22sp"
                android:fontFamily="@font/dm_seriff_display"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>

            <TextView
                android:id="@+id/txtManageDesc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Track enrollments, view schedules, and manage your academic journey — all in one place."
                android:textColor="#7C7EA1"
                android:textSize="14sp"
                android:fontFamily="@font/plus_jakarta_sans"
                android:layout_marginTop="12dp"
                app:layout_constraintTop_toBottomOf="@id/txtManageHeader"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <!-- Features List -->

            <LinearLayout
                android:id="@+id/featureList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="24dp"
                app:layout_constraintTop_toBottomOf="@id/txtManageDesc">

                <!-- Browse -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_circle_small"
                        android:backgroundTint="#EBEAFF">
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/book"
                            app:tint="#5E5CE6"/>
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Browse course catalog"
                        android:textColor="#1A1C3D"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:layout_marginStart="16dp"/>
                </LinearLayout>

                <!-- Enroll -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_circle_small"
                        android:backgroundTint="#F2E7FF">
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/more"
                            app:tint="#9D52E2"/>
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Enroll in new courses"
                        android:textStyle="bold"
                        android:textColor="#1A1C3D"
                        android:textSize="15sp"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:layout_marginStart="16dp"/>
                </LinearLayout>

                <!-- Track -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_circle_small"
                        android:backgroundTint="#E3F9F5">
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/check_2"
                            app:tint="#2ECC71"/>
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Track your progress"
                        android:textStyle="bold"
                        android:textColor="#1A1C3D"
                        android:textSize="15sp"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:layout_marginStart="16dp"/>
                </LinearLayout>

            </LinearLayout>

            <!-- Button -->

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnGetStarted"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Get Started"
                android:textColor="#FFFFFF"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:fontFamily="@font/plus_jakarta_sans"
                android:background="@drawable/bg_button"
                android:layout_marginTop="32dp"
                app:layout_constraintTop_toBottomOf="@id/featureList"/>

            <!-- Footer -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fall 2025 · Westbrook University"
                android:textColor="#A0A2C3"
                android:textSize="12sp"
                android:fontFamily="@font/plus_jakarta_sans"
                android:layout_marginTop="20dp"
                app:layout_constraintTop_toBottomOf="@id/btnGetStarted"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>
