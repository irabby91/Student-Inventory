<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".viewModel.CourseDetailsActivity">

    <!-- Header -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/headerLayout"
        android:layout_width="0dp"
        android:layout_height="200dp"
        android:background="@drawable/bg_header"
        android:padding="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.cardview.widget.CardView
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="32dp"
            app:cardBackgroundColor="#22FFFFFF"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@android:drawable/ic_menu_revert"
                app:tint="@android:color/white"
                android:contentDescription="Back" />
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/tvDetailCode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:fontFamily="@font/plus_jakarta_sans"
            android:letterSpacing="0.15"
            android:text="CS-301"
            android:textColor="#C5C4FF"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@id/btnBack"
            app:layout_constraintTop_toTopOf="@id/btnBack" />

        <TextView
            android:id="@+id/tvDetailName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/dm_seriff_display"
            android:text="Course Details"
            android:textColor="@android:color/white"
            android:textSize="28sp"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="24dp"
            app:layout_constraintStart_toStartOf="@id/tvDetailCode"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvDetailCode" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Info Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:background="#FAFBFF"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerLayout">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="28dp">

            <!-- Detail Cards -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp"
                android:backgroundTint="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="INSTRUCTOR"
                        android:textColor="#7C7EA1"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:letterSpacing="0.1"/>

                    <TextView
                        android:id="@+id/tvDetailInstructor"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Dr. Amara Nwosu"
                        android:textColor="#1A1C3D"
                        android:textSize="18sp"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/plus_jakarta_sans" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#F0F1F7"
                        android:layout_marginVertical="16dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CREDITS"
                        android:textColor="#7C7EA1"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:letterSpacing="0.1"/>

                    <TextView
                        android:id="@+id/tvDetailCredits"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="4 Credits"
                        android:textColor="#1A1C3D"
                        android:textSize="18sp"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/plus_jakarta_sans" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#F0F1F7"
                        android:layout_marginVertical="16dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SCHEDULE"
                        android:textColor="#7C7EA1"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:letterSpacing="0.1"/>

                    <TextView
                        android:id="@+id/tvDetailSchedule"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mon/Wed 10:00 AM"
                        android:textColor="#1A1C3D"
                        android:textSize="18sp"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/plus_jakarta_sans" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#F0F1F7"
                        android:layout_marginVertical="16dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Room"
                        android:textColor="#7C7EA1"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:letterSpacing="0.1"/>

                    <TextView
                        android:id="@+id/tvDetailRoom"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tech Hall 204"
                        android:textColor="#1A1C3D"
                        android:textSize="18sp"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/plus_jakarta_sans" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
